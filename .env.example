# Ed25519 public key used to verify WebSocket client JWTs.
# Use one of these formats:
# 1. PEM text with escaped newlines:
# HLGAM_WS_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 2. Path to a PEM public key file:
# HLGAM_WS_JWT_PUBLIC_KEY_FILE="./keys/ws_public.pem"

HLGAM_WS_JWT_PUBLIC_KEY=""
HLGAM_WS_JWT_AUDIENCE=""
HLGAM_WS_JWT_ISSUER=""

# Learned motion model runtime artifacts. Required only when recognition.models.motion.enabled is true.
HLGAM_MOTION_MODEL_CHECKPOINT=""
HLGAM_MOTION_LABEL_SCHEMA=""
HLGAM_MOTION_FEATURE_SCHEMA=""
HLGAM_MOTION_MODEL_DEVICE="auto"
HLGAM_MOTION_MODEL_THRESHOLD="0.5"
HLGAM_MOTION_MODEL_MIN_SEQUENCE_FRAMES="4"
HLGAM_MOTION_MODEL_MIN_HOLD_MS="0"
HLGAM_MOTION_MODEL_COOLDOWN_MS="250"
HLGAM_MOTION_MODEL_ID=""
